# Все переменные необязательны: значения по умолчанию подходят для локального запуска.
ADDR=:8090
DATABASE_URL=postgres://aggregator:aggregator@localhost:55442/aggregator?sslmode=disable
REDIS_URL=redis://localhost:56389/0
PUBLIC_URL=http://localhost:3100
API_BASE_URL=http://localhost:3100/v1
SECRET_KEY=change-me-to-a-long-random-string
SECURE_COOKIES=false
# Эти адреса получают роль admin при регистрации. Первый зарегистрированный пользователь тоже становится админом.
ADMIN_EMAILS=admin@local.test
# Вход через сервисы. Redirect URI для каждого: http://localhost:3100/api/auth/oauth/{github|yandex|vk}/callback
# GitHub: github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Яндекс ID: oauth.yandex.ru, доступы login:email, login:info, login:avatar
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID: id.vk.com -> приложение, доступ email
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Курс валют
FX_REFRESH=1h
FX_CBR_URL=https://www.cbr.ru/scripts/XML_daily.asp
FX_BACKUP_URL=https://www.cbr-xml-daily.ru/daily_json.js
PAYMENT_PROVIDER=fake
# Уведомления админам в Telegram: токен от @BotFather. Чаты можно указать здесь или в админке (Поддержка → Уведомления в Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
